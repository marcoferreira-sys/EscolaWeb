digraph G {
rankdir=LR; splines=true; nodesep=0.5; ranksep=1.1; bgcolor="white";
label=<<B>Modelo físico – banco escola_web (PostgreSQL)</B>>; labelloc=t; fontsize=20; fontname="Helvetica";
node [shape=plain fontname="Helvetica" fontsize=11]; edge [fontname="Helvetica" fontsize=9 color="#555555"];
